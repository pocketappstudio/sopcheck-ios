# Reused from the Buck Ledger pipeline (same Apple account, same App Store Connect API key secrets). Single target, no extensions.
require 'base64'
default_platform(:ios)
platform :ios do
  # Signed App Store build WITHOUT uploading and WITHOUT an App Store Connect app record.
  # Registers only the developer-portal bundle id (identifier) if missing, then signs and exports an .ipa.
  lane :signed_build do
    setup_ci
    api_key = app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_content: ENV["ASC_KEY_P8"], is_key_content_base64: true)
    team = ENV["APPLE_TEAM_ID"]; id = "com.pocketappstudio.sopcheck"
    unless Spaceship::ConnectAPI::BundleId.find(id)
      Spaceship::ConnectAPI::BundleId.create(name: "SOPCheck", platform: "IOS", identifier: id)
      UI.message("Registered bundle id #{id} (developer portal identifier only; no App Store Connect record)")
    end
    File.binwrite("/tmp/dist.p12", Base64.decode64(ENV["DIST_CERT_P12_BASE64"]))
    import_certificate(certificate_path: "/tmp/dist.p12", certificate_password: ENV["DIST_CERT_PASSWORD"], keychain_name: "fastlane_tmp_keychain", keychain_password: "")
    sigh(api_key: api_key, app_identifier: id, team_id: team, force: true, filename: "#{id}.mobileprovision")
    profile = lane_context[SharedValues::SIGH_NAME]
    increment_build_number(xcodeproj: "ios/App/App.xcodeproj", build_number: (ENV["GITHUB_RUN_NUMBER"].to_i + 10).to_s  # +10: builds 1-4 were used by the old sopcheck-mobile repo)
    update_code_signing_settings(use_automatic_signing: false, path: "ios/App/App.xcodeproj", targets: ["App"], team_id: team,
      code_sign_identity: "Apple Distribution", profile_name: profile, bundle_identifier: id)
    build_app(workspace: "ios/App/App.xcworkspace", scheme: "App", export_method: "app-store", output_directory: "build", output_name: "SOPCheck.ipa",
      export_options: { signingStyle: "manual", teamID: team, provisioningProfiles: { id => profile } })
  end

  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_content: ENV["ASC_KEY_P8"], is_key_content_base64: true)
    team = ENV["APPLE_TEAM_ID"]; id = "com.pocketappstudio.sopcheck"
    File.binwrite("/tmp/dist.p12", Base64.decode64(ENV["DIST_CERT_P12_BASE64"]))
    import_certificate(certificate_path: "/tmp/dist.p12", certificate_password: ENV["DIST_CERT_PASSWORD"], keychain_name: "fastlane_tmp_keychain", keychain_password: "")
    sigh(api_key: api_key, app_identifier: id, team_id: team, force: true, filename: "#{id}.mobileprovision")
    profile = lane_context[SharedValues::SIGH_NAME]
    increment_build_number(xcodeproj: "ios/App/App.xcodeproj", build_number: (ENV["GITHUB_RUN_NUMBER"].to_i + 10).to_s  # +10: builds 1-4 were used by the old sopcheck-mobile repo)
    update_code_signing_settings(use_automatic_signing: false, path: "ios/App/App.xcodeproj", targets: ["App"], team_id: team,
      code_sign_identity: "Apple Distribution", profile_name: profile, bundle_identifier: id)
    build_app(workspace: "ios/App/App.xcworkspace", scheme: "App", export_method: "app-store",
      export_options: { signingStyle: "manual", teamID: team, provisioningProfiles: { id => profile } })
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
